# The publishable key is safe for client exposure, but the app reads it only on the server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only. Required by the runtime OSM candidate query/download routes and
# by scripts/import-tokyo-reuse-data.py --apply. Never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Qwen vision configuration.
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Server-only text model for explicit move-plan generation requests.
QWEN_TEXT_MODEL=qwen3.7-plus
